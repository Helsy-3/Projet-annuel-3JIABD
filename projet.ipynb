  {
   "cell_type": "markdown",
   "id": "632c8ab3",
   "metadata": {},
   "source": [
    "**Particularite du branchement ici** : contrairement aux autres etapes, la fonction `RBNF()` du fichier C ne renvoie rien a Python (elle fait juste des `printf` en C). On appelle donc depuis Python, dans le meme ordre que `RBNF()` le fait en interne, les fonctions individuelles (k-means, sigma, entrainement des poids, prediction) pour recuperer les resultats.\n",
    "\n",
    "On a aussi trouve et corrige deux problemes dans le C en testant :\n",
    "- **Cluster vide → `NaN`** : `find_centroids()` pouvait tirer deux fois le meme point, donc un cluster restait vide et `update_centroids()` divisait par zero. Le `NaN` contaminait sigma puis tout le modele (prediction constante, fond uni sur le graphe). Corrige avec un tirage sans remise et en ignorant les clusters vides.\n",
    "- **Sigma trop large** : la moyenne des distances entre *toutes* les paires de centroides donnait des gaussiennes de la taille du dataset. Sigma est maintenant la distance moyenne de chaque centroide a son plus proche voisin."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b0314029",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-21T12:48:52.919695Z",
     "iopub.status.busy": "2026-10-21T12:48:52.919021Z",
     "iopub.status.idle": "2026-10-21T12:48:52.966746Z",
     "shell.execute_reply": "2026-10-21T12:48:52.964759Z"
    }
   },
   "outputs": [],
   "source": [
    "# ==================================================\n",
    "# ETAPE 5 : RBF NETWORK\n",
    "# ==================================================\n",
    "\n",
    "import contextlib\n",
    "\n",
    "lib_rbf = ctypes.CDLL(\"C-algorithms/ETAPE5.RBF.so\")\n",
    "\n",
    "lib_rbf.find_centroids.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, P_DOUBLE, P_DOUBLE]\n",
    "lib_rbf.find_centroids.restype = None\n",
    "\n",
    "lib_rbf.assign_clusters.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, P_DOUBLE, P_DOUBLE, P_INT, P_INT]\n",
    "lib_rbf.assign_clusters.restype = None\n",
    "\n",
    "lib_rbf.update_centroids.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, P_DOUBLE, P_INT, P_INT, P_DOUBLE]\n",
    "lib_rbf.update_centroids.restype = None\n",
    "\n",
    "lib_rbf.calculer_sigma.argtypes = [ctypes.c_int, ctypes.c_int, P_DOUBLE]\n",
    "lib_rbf.calculer_sigma.restype = ctypes.c_double\n",
    "\n",
    "lib_rbf.calculer_dot_rbf_closeness_to_centroids.argtypes = [\n",
    "    ctypes.c_int, P_DOUBLE, ctypes.c_int, P_DOUBLE,\n",
    "    ctypes.c_double, P_DOUBLE\n",
    "]\n",
    "lib_rbf.calculer_dot_rbf_closeness_to_centroids.restype = None\n",
    "\n",
    "lib_rbf.recursive_train_weights.argtypes = [\n",
    "    ctypes.c_int, ctypes.c_int, ctypes.c_int, P_DOUBLE, P_DOUBLE, P_DOUBLE,\n",
    "    ctypes.c_double, P_DOUBLE, ctypes.c_double, ctypes.c_int\n",
    "]\n",
    "lib_rbf.recursive_train_weights.restype = None\n",
    "\n",
    "lib_rbf.calculer_dot_output.argtypes = [ctypes.c_int, P_DOUBLE, P_DOUBLE]\n",
    "lib_rbf.calculer_dot_output.restype = ctypes.c_double\n",
    "\n",
    "\n",
    "class RBF:\n",
    "    \"\"\"Réseau RBF à deux classes (-1 et 1). k = nombre de centroïdes.\"\"\"\n",
    "\n",
    "    def __init__(self, k=10, learning_rate=0.01, epochs=500):\n",
    "        self.k_souhaite, self.learning_rate, self.epochs = k, learning_rate, epochs\n",
    "\n",
    "    def _clustering(self, dataset_array, k, nombre_points, vecteur_dimensions):\n",
    "        \"\"\"Exécute K-means pour trouver les centroïdes.\"\"\"\n",
    "\n",
    "        # Crée le tableau qui recevra les centroïdes.\n",
    "        centroids_array = np.zeros((k, vecteur_dimensions), dtype=np.float64)\n",
    "\n",
    "        # Initialise les centroïdes avec la bibliothèque C.\n",
    "        lib_rbf.find_centroids(\n",
    "            k,\n",
    "            nombre_points,\n",
    "            vecteur_dimensions,\n",
    "            dataset_array.ctypes.data_as(P_DOUBLE),\n",
    "            centroids_array.ctypes.data_as(P_DOUBLE)\n",
    "        )\n",
    "\n",
    "        clusters_centroids_array = np.zeros((k, nombre_points), dtype=np.int32)\n",
    "        clusters_sizes = np.zeros(k, dtype=np.int32)\n",
    "\n",
    "        # Répète les étapes de K-means pour stabiliser les centroïdes.\n",
    "        for _ in range(100):\n",
    "            # Affecte chaque point au centroïde le plus proche.\n",
    "            lib_rbf.assign_clusters(\n",
    "                k,\n",
    "                nombre_points,\n",
    "                vecteur_dimensions,\n",
    "                dataset_array.ctypes.data_as(P_DOUBLE),\n",
    "                centroids_array.ctypes.data_as(P_DOUBLE),\n",
    "                clusters_centroids_array.ctypes.data_as(P_INT),\n",
    "                clusters_sizes.ctypes.data_as(P_INT)\n",
    "            )\n",
    "\n",
    "            # Recalcule les centroïdes à partir de leurs points.\n",
    "            lib_rbf.update_centroids(\n",
    "                k,\n",
    "                nombre_points,\n",
    "                vecteur_dimensions,\n",
    "                dataset_array.ctypes.data_as(P_DOUBLE),\n",
    "                clusters_centroids_array.ctypes.data_as(P_INT),\n",
    "                clusters_sizes.ctypes.data_as(P_INT),\n",
    "                centroids_array.ctypes.data_as(P_DOUBLE)\n",
    "            )\n",
    "\n",
    "        return centroids_array\n",
    "\n",
    "    def entrainer_RBF(self, dataset_array, y):\n",
    "        dataset_array = np.ascontiguousarray(dataset_array, dtype=np.float64)\n",
    "        y = np.ascontiguousarray(y, dtype=np.float64)\n",
    "\n",
    "        dataset_length, vector_length = dataset_array.shape\n",
    "        k = min(self.k_souhaite, dataset_length)\n",
    "\n",
    "        # ETAPE 1 : Trouver les centroïdes\n",
    "        centroids = self._clustering(dataset_array, k, dataset_length, vector_length)\n",
    "\n",
    "        # ETAPE 2 : Calculer sigma\n",
    "        sigma = lib_rbf.calculer_sigma(k, vector_length, centroids.ctypes.data_as(P_DOUBLE))\n",
    "\n",
    "        # ETAPE 3 : Initialiser les poids\n",
    "        poids = np.zeros(k, dtype=np.float64)\n",
    "\n",
    "        # ETAPE 4 : Entraîner les poids (affiche un printf() par epoch dans la console, normal)\n",
    "        lib_rbf.recursive_train_weights(\n",
    "            k, dataset_length, vector_length,\n",
    "            dataset_array.ctypes.data_as(P_DOUBLE),\n",
    "            y.ctypes.data_as(P_DOUBLE),\n",
    "            centroids.ctypes.data_as(P_DOUBLE),\n",
    "            sigma,\n",
    "            poids.ctypes.data_as(P_DOUBLE),\n",
    "            self.learning_rate,\n",
    "            self.epochs\n",
    "        )\n",
    "\n",
    "        # Stocker les paramètres du modèle\n",
    "        self.k = k\n",
    "        self.centroids = centroids\n",
    "        self.sigma = sigma\n",
    "        self.poids = poids\n",
    "\n",
    "        return self\n",
    "\n",
    "    def score_RBF(self, dataset):\n",
    "        \"\"\"Calcule le score numérique RBF de chaque point.\"\"\"\n",
    "\n",
    "        dataset = np.ascontiguousarray(np.atleast_2d(dataset), dtype=np.float64)\n",
    "        vector_length = dataset.shape[1] # Nombre de caractéristiques de chaque point fourni en entrée.\n",
    "        dot_proximity_to_centroids = np.zeros(self.k) # Tableau contenant les proximités avec les k centroïdes.\n",
    "        output_array = np.zeros(len(dataset)) # Tableau contenant le score final de chaque point.\n",
    "\n",
    "        for i, dot in enumerate(dataset):\n",
    "            # Calcule la proximité RBF entre le point et chaque centroïde.\n",
    "            lib_rbf.calculer_dot_rbf_closeness_to_centroids(\n",
    "                vector_length,\n",
    "                dot.ctypes.data_as(P_DOUBLE),\n",
    "                self.k,\n",
    "                self.centroids.ctypes.data_as(P_DOUBLE),\n",
    "                self.sigma,\n",
    "                dot_proximity_to_centroids.ctypes.data_as(P_DOUBLE)\n",
    "            )\n",
    "\n",
    "            # Combine les proximités avec les poids appris.\n",
    "            output_array[i] = lib_rbf.calculer_dot_output(\n",
    "                self.k,\n",
    "                dot_proximity_to_centroids.ctypes.data_as(P_DOUBLE),\n",
    "                self.poids.ctypes.data_as(P_DOUBLE)\n",
    "            )\n",
    "\n",
    "        return output_array\n",
    "\n",
    "    def predire_RBF(self, dataset):\n",
    "        \"\"\"Convertit les scores en classes -1 ou 1.\"\"\"\n",
    "        return np.where(self.score_RBF(dataset) >= 0, 1, -1)\n",
    "\n",
    "    entrainer, predire = entrainer_RBF, predire_RBF\n",
    "\n",
    "\n",
    "class RBFMultiClasse:\n",
    "    \"\"\"Classification multiclasse selon la méthode un contre tous.\n",
    "    Un modèle RBF est entraîné pour chaque classe.\"\"\"\n",
    "\n",
    "    def __init__(self, **parametres):\n",
    "        self.parametres = parametres\n",
    "\n",
    "    def entrainer_RBFMultiClasse(self, X, y):\n",
    "        self.classes = np.unique(y) # Récupère les classes présentes dans les étiquettes.\n",
    "        self.modeles = []\n",
    "\n",
    "        for clss in self.classes:\n",
    "            y_binaire = np.where(y == clss, 1, -1)\n",
    "            y_binaire = y_binaire.astype(float)\n",
    "            modele = RBF(**self.parametres)\n",
    "            modele.entrainer_RBF(X, y_binaire)\n",
    "            self.modeles.append(modele)\n",
    "        return self\n",
    "\n",
    "    def predire_RBFMultiClasse(self, dataset):\n",
    "        # Calcule les scores de tous les modèles.\n",
    "        scores = np.array([m.score_RBF(dataset) for m in self.modeles])\n",
    "\n",
    "        # Pour chaque point, renvoie la classe dont le modèle possède le score le plus élevé.\n",
    "        return self.classes[np.argmax(scores, axis=0)]\n",
    "\n",
    "    entrainer, predire = entrainer_RBFMultiClasse, predire_RBFMultiClasse"
   ]
  },
