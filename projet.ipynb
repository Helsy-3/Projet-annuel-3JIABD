    "<div style=\"background: linear-gradient(to right, #4a86e8 50%, #cc0000 50%); color:white; padding:10px; border-radius:5px; font-size:1.2em; font-weight:bold; text-align:center;\">Étape 5 : RBF Network (k-means + fonctions à base radiale)</div>"
   ]
