    "def tracer(ax, modele, X, y, titre):\n",
    "    # On trace la frontiere de decision en coloriant tout un quadrillage de points\n",
    "    # fictifs selon la prediction du modele (contourf), puis on superpose les vrais\n",
    "    # points du dataset (scatter) - ca permet de VOIR la forme que le modele a apprise,\n",
    "    # pas juste un chiffre de precision.\n",
    "    x0, x1 = X[:, 0].min() - 0.5, X[:, 0].max() + 0.5\n",
    "    y0, y1 = X[:, 1].min() - 0.5, X[:, 1].max() + 0.5\n",
    "    xx, yy = np.meshgrid(np.linspace(x0, x1, 80), np.linspace(y0, y1, 80))\n",
    "    z = modele.predire(np.c_[xx.ravel(), yy.ravel()])\n",
    "    ax.contourf(xx, yy, z.reshape(xx.shape), alpha=0.3, cmap=\"brg\")\n",
    "    ax.scatter(X[:, 0], X[:, 1], c=y, cmap=\"brg\", edgecolors=\"k\", s=20)\n",
    "    ax.set_title(titre, fontsize=9)\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(13, 8))\n",
    "\n",
    "cas = [\n",
    "    (\"Linear Simple\", (np.array([[1, 1], [2, 3], [3, 3]], dtype=float), np.array([1, -1, -1])), Perceptron(), True),\n",
    "    (\"Linear Multiple\", generate_linear_cluster_dots_configuration(), Perceptron(), True),\n",
    "    (\"XOR (non lineaire)\", (np.array([[1, 0], [0, 1], [0, 0], [1, 1]], dtype=float), np.array([1, 1, -1, -1])), Perceptron(), False),\n",
    "    (\"Cross (non lineaire)\", generate_cross_dots_configuration(), Perceptron(), False),\n",
    "    (\"Multi Linear 3 classes\", generate_multi_linear_3_classes_dots_configuration(), PerceptronMultiClasse(), True),\n",
    "    (\"Multi Cross (non lineaire)\", generate_multi_cross_configuration(), PerceptronMultiClasse(), False),\n",
    "]\n",
    "\n",
    "# doit_reussir : ce qu'on ATTEND du perceptron pour chaque cas (True = lineaire, doit\n",
    "# reussir ; False = non lineaire, echec attendu) - sert juste a annoter l'affichage,\n",
    "# pas a changer le comportement du modele.\n",
    "for ax, (nom, (X, y), modele, doit_reussir) in zip(axes.ravel(), cas):\n",
    "    modele.entrainer(X, y)\n",
    "    precision = (modele.predire(X) == y).mean()\n",
    "    attendu = \"reussite attendue\" if doit_reussir else \"echec attendu (non lineaire)\"\n",
    "    print(f\"{nom} : precision {precision:.0%} ({attendu})\")\n",
    "    tracer(ax, modele, X, y, f\"{nom} - {precision:.0%}\")\n",
    "\n",
    "fig.tight_layout()\n",
    "plt.show()\n"
   ]
  },
