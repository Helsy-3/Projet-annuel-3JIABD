   "source": [
    "X = np.array([\n",
    "    [1, 1],\n",
    "    [2, 3],\n",
    "    [3, 3]\n",
    "])\n",
    "\n",
    "y = np.array([\n",
    "    1, -1, -1\n",
    "])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "c9809148",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Erreurs finales : 0 / 3\n",
      "Poids appris par le C : w1 = 0.0  w2 = -0.3  bias = 0.3\n"
     ]
    }
   ],
   "source": [
    "# ==================================================\n",
    "# ICI ON RELIE LA BIBLIOTHEQUE C A PYTHON (ctypes)\n",
    "# ==================================================\n",
    "lib_etape1 = ctypes.CDLL(\"C-algorithms/ETAPE1.basicPerceptron.so\")\n",
    "\n",
    "# Nombre d'erreurs sur le cas de test\n",
    "lib_etape1.run_perceptron.restype = ctypes.c_int\n",
    "erreurs = lib_etape1.run_perceptron()\n",
    "\n",
    "# Poids appris par le perceptron en C (pour tracer la droite de separation)\n",
    "lib_etape1.entrainer_perceptron.argtypes = [\n",
    "    ctypes.POINTER(ctypes.c_double),\n",
    "    ctypes.POINTER(ctypes.c_double),\n",
    "]\n",
    "lib_etape1.entrainer_perceptron.restype = ctypes.c_int\n",
    "\n",
    "poids = (ctypes.c_double * 2)()\n",
    "bias = ctypes.c_double()\n",
    "lib_etape1.entrainer_perceptron(poids, ctypes.byref(bias))\n",
    "w1, w2, b = poids[0], poids[1], bias.value\n",
    "\n",
    "print(\"Erreurs finales :\", erreurs, \"/ 3\")\n",
    "print(\"Poids appris par le C : w1 =\", round(w1, 3), \" w2 =\", round(w2, 3), \" bias =\", round(b, 3))\n"
   ]
  },
