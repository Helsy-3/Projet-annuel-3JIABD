    "class SVM:\n",
    "    \"\"\"Un SVM a 2 classes : garde les donnees et les coefficients appris par le C.\"\"\"\n",
    "\n",
    "    def __init__(self, noyau=LINEAIRE, gamma=1.0, C=1000.0, max_iter=10000):\n",
    "        # C=1000 (grand) : on autorise peu de tolerance aux erreurs d'entrainement -\n",
    "        # raisonnable ici car nos cas de test sont propres (pas de bruit a ignorer).\n",
    "        # gamma=1.0 par defaut : largeur de gaussienne moyenne, ajustee au cas par cas\n",
    "        # plus bas (un gamma trop petit \"lisse\" trop, trop grand memorise les points).\n",
    "        self.noyau, self.gamma, self.C, self.max_iter = noyau, gamma, C, max_iter\n",
    "\n",
    "    def entrainer(self, X, y):\n",
    "        self.X = np.ascontiguousarray(X, dtype=np.float64)\n",
    "        y = np.ascontiguousarray(y, dtype=np.int32)\n",
    "        self.coefs = np.zeros(len(self.X))\n",
    "        self.n_supports = lib_svm.svm_entrainer(\n",
    "            self.X.ctypes.data_as(P_DOUBLE), y.ctypes.data_as(P_INT), len(self.X), self.X.shape[1],\n",
    "            self.noyau, self.gamma, self.C, self.max_iter, self.coefs.ctypes.data_as(P_DOUBLE))\n",
    "        return self\n",
    "\n",
    "    def score(self, points):\n",
    "        points = np.ascontiguousarray(np.atleast_2d(points), dtype=np.float64)\n",
    "        return np.array([lib_svm.svm_score(self.X.ctypes.data_as(P_DOUBLE), self.coefs.ctypes.data_as(P_DOUBLE),\n",
    "                                           len(self.X), self.X.shape[1], self.noyau, self.gamma,\n",
    "                                           p.ctypes.data_as(P_DOUBLE))\n",
    "                         for p in points])\n",
    "\n",
    "    def predire(self, points):\n",
    "        return np.where(self.score(points) >= 0, 1, -1)\n",
    "\n",
    "\n",
    "class SVMMultiClasse:\n",
    "    \"\"\"Un contre tous : un SVM par classe, on garde la classe au score le plus haut.\n",
    "    Pourquoi ce choix : le SVM en C ne separe que 2 classes - on entraine donc un SVM\n",
    "    binaire par classe (\"cette classe, oui ou non ?\") et on garde celui qui est le plus\n",
    "    confiant. C'est de l'orchestration en Python, pas une reimplementation de l'algorithme.\"\"\"\n",
    "\n",
    "    def __init__(self, **parametres):\n",
    "        self.parametres = parametres\n",
    "\n",
    "    def entrainer(self, X, y):\n",
    "        self.classes = np.unique(y)\n",
    "        self.svms = [SVM(**self.parametres).entrainer(X, np.where(y == c, 1, -1))\n",
    "                     for c in self.classes]\n",
    "        return self\n",
    "\n",
    "    def predire(self, points):\n",
    "        scores = np.array([svm.score(points) for svm in self.svms])\n",
    "        return self.classes[np.argmax(scores, axis=0)]\n"
   ]
  },
