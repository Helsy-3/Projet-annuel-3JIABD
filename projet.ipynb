    "def image_vers_vecteur(chemin, taille=(2, 2)):\n",
    "    img = Image.open(chemin).convert(\"RGB\")\n",
    "    img = img.resize(taille)\n",
    "    array = np.array(img) / 255.0\n",
    "    return array.flatten()\n",
    "\n",
    "def lister_images(dossier):\n",
    "    extensions = (\".jpg\", \".jpeg\", \".png\", \".webp\")\n",
    "    return [\n",
    "        os.path.join(dossier, fichier)\n",
    "        for fichier in sorted(os.listdir(dossier))\n",
    "        if fichier.lower().endswith(extensions)\n",
    "    ]\n",
    "\n",
    "def separer_train_test(chemins, categories, proportion_test=0.2, graine=0):\n",
    "    random_numbers = np.random.default_rng(graine) # générateur de nombre aléatoire créé avec numpy\n",
    "    chemins = np.array(chemins) # on crée un tableau des chemins\n",
    "    train_index, test_index = [], []\n",
    "    for clss in np.unique(categories):\n",
    "        idx = np.where(categories == clss)[0]\n",
    "        random_numbers.shuffle(idx)\n",
    "        n_test = max(1, round(len(idx) * proportion_test))\n",
    "        test_index.extend(idx[:n_test])\n",
    "        train_index.extend(idx[n_test:])\n",
    "    return (chemins[train_index].tolist(), categories[train_index],\n",
    "            chemins[test_index].tolist(), categories[test_index])\n"
   ]
