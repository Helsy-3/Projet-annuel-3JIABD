    "# ==================================================\n",
    "# ETAPE 4: SVM\n",
    "# ==================================================\n",
    "lib_svm = ctypes.CDLL(\"C-algorithms/ETAPE4.svm.so\")\n",
    "\n",
    "LINEAIRE, NOYAU_RBF = 0, 1  # correspond aux constantes NOYAU_LINEAIRE=0 / NOYAU_RBF=1 cote C\n",
    "\n",
    "lib_svm.svm_entrainer.argtypes = [P_DOUBLE, P_INT, ctypes.c_int, ctypes.c_int, ctypes.c_int,\n",
    "                                  ctypes.c_double, ctypes.c_double, ctypes.c_int, P_DOUBLE]\n",
    "lib_svm.svm_entrainer.restype = ctypes.c_int\n",
    "lib_svm.svm_score.argtypes = [P_DOUBLE, P_DOUBLE, ctypes.c_int, ctypes.c_int, ctypes.c_int,\n",
    "                              ctypes.c_double, P_DOUBLE]\n",
    "lib_svm.svm_score.restype = ctypes.c_double\n"
   ]
