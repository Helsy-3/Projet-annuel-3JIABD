    "# ==================================================\n",
    "# ETAPE 3 - PERCEPTRON MULTICOUCHES.C\n",
    "# ==================================================\n",
    "lib_pmc = ctypes.CDLL(\"C-algorithms/ETAPE3.multiLayersPerceptron.so\")\n",
    "\n",
    "P_INT = ctypes.POINTER(ctypes.c_int)\n",
    "P_DOUBLE = ctypes.POINTER(ctypes.c_double)\n",
    "\n",
    "lib_pmc.run_pmc_dataset.argtypes = [\n",
    "    P_DOUBLE,\n",
    "    P_INT,\n",
    "    ctypes.c_int,\n",
    "    ctypes.c_int,\n",
    "    P_INT,\n",
    "    ctypes.POINTER(P_DOUBLE),\n",
    "    ctypes.POINTER(P_DOUBLE)\n",
    "]\n",
    "\n",
    "lib_pmc.run_pmc_dataset.restype = ctypes.c_int\n",
    "\n",
    "def entrainer_pmc(vecteurs, classes, architecture):\n",
    "    \"\"\"\n",
    "    Entraîne un PMC avec une architecture configurable. Exemple : [12, 16, 32, 8, 3]\n",
    "    \"\"\"\n",
    "    vecteurs = np.ascontiguousarray(vecteurs, dtype=np.float64)\n",
    "    \"\"\" les classes sont converties en entiers de 32 bits \"\"\"\n",
    "    classes = np.ascontiguousarray(classes, dtype=np.int32)\n",
    "    architecture = np.asarray(architecture, dtype=np.int32)\n",
    "    nb_couches = len(architecture)\n",
    "\n",
    "    if nb_couches < 2:\n",
    "        raise ValueError(\"Il faut au moins une couche d'entrée et une couche de sortie.\")\n",
    "\n",
    "    if np.any(architecture <= 0):\n",
    "        raise ValueError(\"Chaque couche doit contenir au moins un neurone.\")\n",
    "\n",
    "    if vecteurs.ndim != 2 or vecteurs.shape[1] != architecture[0]:\n",
    "        raise ValueError(\"Dimension des entrées incompatible.\")\n",
    "\n",
    "    if len(classes) != len(vecteurs):\n",
    "        raise ValueError(\"Le nombre de classes doit correspondre aux exemples.\")\n",
    "\n",
    "    poids = []\n",
    "    biais = []\n",
    "\n",
    "    for i in range(nb_couches - 1):\n",
    "        poids.append(\n",
    "            np.zeros(architecture[i] * architecture[i + 1], dtype=np.float64)\n",
    "        )\n",
    "        biais.append(\n",
    "            np.zeros(architecture[i + 1], dtype=np.float64)\n",
    "        )\n",
    "    return poids, biais\n",
    "\n",
    "\n",
    "def predire_pmc(vecteur, poids, in_dim=12):\n",
    "    \"\"\"Predit la classe d'un seul exemple a partir de poids DEJA entraines (pas d'entrainement ici).\n",
    "    h_dim n'est pas un parametre : on le retrouve directement depuis la taille de b1.\"\"\"\n",
    "    W1, b1, W2, b2 = poids\n",
    "    h_dim = len(b1)\n",
    "    vecteur = np.ascontiguousarray(vecteur, dtype=np.float64)\n",
    "    return lib_pmc.predire_pmc(\n",
    "        vecteur.ctypes.data_as(P_DOUBLE),\n",
    "        W1.ctypes.data_as(P_DOUBLE), b1.ctypes.data_as(P_DOUBLE),\n",
    "        W2.ctypes.data_as(P_DOUBLE), b2.ctypes.data_as(P_DOUBLE),\n",
    "        in_dim, h_dim, OUT_DIM)\n"
   ]
  },
