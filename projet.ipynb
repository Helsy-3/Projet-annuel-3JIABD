    "# ==================================================\n",
    "# ETAPE 2 - XOR\n",
    "# ==================================================\n",
    "lib_etape2 = ctypes.CDLL('C-algorithms/ETAPE2.xor.so')\n",
    "\n",
    "P_DOUBLE = ctypes.POINTER(ctypes.c_double)\n",
    "P_INT = ctypes.POINTER(ctypes.c_int)\n",
    "ARGS_ENTRAINER = [P_DOUBLE, P_INT, ctypes.c_int, ctypes.c_int,\n",
    "                  ctypes.c_double, ctypes.c_int, P_DOUBLE, P_DOUBLE]\n",
    "\n",
    "lib_etape2.entrainer_perceptron.argtypes = ARGS_ENTRAINER\n",
    "lib_etape2.entrainer_perceptron.restype = ctypes.c_int\n",
    "lib_etape2.entrainer_perceptron_transforme.argtypes = ARGS_ENTRAINER\n",
    "lib_etape2.entrainer_perceptron_transforme.restype = ctypes.c_int\n",
    "\n",
    "\n",
    "def entrainer_xor(transforme, learning_rate=0.1, max_iter=1000):\n",
    "    \"\"\"Appelle le perceptron C sur XOR (brut ou transforme). Renvoie (erreurs, poids, biais).\n",
    "\n",
    "    Pourquoi deux fonctions C differentes plutot qu'une seule avec un parametre :\n",
    "    transforme=False utilise directement [x1, x2] (2 poids) ; transforme=True ajoute la\n",
    "    caracteristique x1*x2 avant d'entrainer (3 poids) - cette seule caracteristique en plus\n",
    "    suffit a rendre XOR lineairement separable, sans changer l'algorithme du perceptron.\"\"\"\n",
    "    X = np.ascontiguousarray(X_xor, dtype=np.float64)\n",
    "    y = np.ascontiguousarray(y_xor, dtype=np.int32)\n",
    "    n_exemples, n_features = X.shape\n",
    "    n_poids = 3 if transforme else n_features\n",
    "    poids = np.zeros(n_poids)\n",
    "    biais = ctypes.c_double(0.0)\n",
    "    fonction = lib_etape2.entrainer_perceptron_transforme if transforme else lib_etape2.entrainer_perceptron\n",
    "    erreurs = fonction(X.ctypes.data_as(P_DOUBLE), y.ctypes.data_as(P_INT),\n",
    "                       n_exemples, n_features, learning_rate, max_iter,\n",
    "                       poids.ctypes.data_as(P_DOUBLE), ctypes.byref(biais))\n",
    "    return erreurs, poids, biais.value\n",
    "\n",
    "\n",
    "erreurs_brut, poids_brut, bias_brut = entrainer_xor(transforme=False)\n",
    "erreurs_transforme, poids_transforme, bias_t = entrainer_xor(transforme=True)\n",
    "w1_brut, w2_brut = poids_brut\n",
    "w1_t, w2_t, w3_t = poids_transforme\n",
    "\n",
    "print(\"XOR brut - erreurs :\", erreurs_brut)\n",
    "print(\"XOR transformé - erreurs :\", erreurs_transforme)\n",
    "print(\"Poids appris par le C (brut) :\", round(w1_brut, 3), round(w2_brut, 3), round(bias_brut, 3))\n",
    "print(\"Poids appris par le C (transforme) :\", round(w1_t, 3), round(w2_t, 3), round(w3_t, 3), round(bias_t, 3))\n"
   ]
  },
