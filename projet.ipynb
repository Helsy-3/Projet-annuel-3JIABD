    "rng = np.random.default_rng(0) # graine fixe (0) : les memes points aleatoires sont generes a chaque execution, pour pouvoir comparer les resultats entre modeles (perceptron, SVM, RBF)\n",
    "\n",
    "def generate_linear_cluster_dots_configuration(): # on rajoute deux groupes de 50 points aléatoires, l'un près de (1, 1), l'autre près de (2, 2)\n",
    "    # Pourquoi ce cas : deux nuages de points bien separes, aucune ambiguite possible -\n",
    "    # un modele lineaire DOIT reussir ici, sinon il y a un vrai probleme.\n",
    "    X = np.concatenate([rng.random((50, 2)) * 0.9 + [1, 1], rng.random((50, 2)) * 0.9 + [2, 2]])\n",
    "    y = np.concatenate([np.ones(50), -np.ones(50)]).astype(int)\n",
    "    return X, y\n",
    "\n",
    "def generate_cross_dots_configuration(): # cette fonction crée des points qui sont agencés dans l'espace en forme de croix. (forme complexe)\n",
    "    # Pourquoi ce cas : la frontiere (une croix) n'est pas une seule droite - aucun modele\n",
    "    # lineaire ne peut la representer, meme si chaque \"bras\" de la croix est droit.\n",
    "    X = rng.random((500, 2)) * 2.0 - 1.0\n",
    "    return X, np.array([1 if abs(p[0]) <= 0.3 or abs(p[1]) <= 0.3 else -1 for p in X])\n",
    "\n",
    "def generate_multi_linear_3_classes_dots_configuration():\n",
    "    # Pourquoi ce cas : 3 classes separees par des droites (pas de courbe) - teste le\n",
    "    # \"un contre tous\" (PerceptronMultiClasse/SVMMultiClasse/RBFMultiClasse) sur un\n",
    "    # probleme qui reste simple pour un modele lineaire.\n",
    "    X = rng.random((500, 2)) * 2.0 - 1.0 # rng.random((500, 2)) génère une matrice de 500 lignes et 2 colonnes.\n",
    "    y = []\n",
    "    for p in X:\n",
    "        if -p[0] - p[1] - 0.5 > 0 and p[1] < 0 and p[0] - p[1] - 0.5 < 0:\n",
    "            y.append(0)\n",
    "        elif -p[0] - p[1] - 0.5 < 0 and p[1] > 0 and p[0] - p[1] - 0.5 < 0:\n",
    "            y.append(1)\n",
    "        elif -p[0] - p[1] - 0.5 < 0 and p[1] < 0 and p[0] - p[1] - 0.5 > 0:\n",
    "            y.append(2)\n",
    "        else:\n",
    "            y.append(-1)\n",
    "    y = np.array(y)\n",
    "    return X[y >= 0], y[y >= 0]\n",
    "\n",
    "def generate_multi_cross_configuration():\n",
    "    # Pourquoi ce cas : un damier (motif qui se repete) avec 3 classes - le cas le plus\n",
    "    # difficile des 6, pensé pour montrer la limite des modeles meme non lineaires\n",
    "    # (voir la limite connue du RBF documentee dans le README).\n",
    "    X = rng.random((1000, 2)) * 2.0 - 1.0\n",
    "    y = []\n",
    "    for p in X:\n",
    "        if abs(p[0] % 0.5) <= 0.25 and abs(p[1] % 0.5) > 0.25:\n",
    "            y.append(0)\n",
    "        elif abs(p[0] % 0.5) > 0.25 and abs(p[1] % 0.5) <= 0.25:\n",
    "            y.append(1)\n",
    "        else:\n",
    "            y.append(2)\n",
    "    return X, np.array(y)"
   ]
